# Adaptive Memory Engine (AME) - Backend Configuration Template

# Active Profile Mode: development | staging | production
ENV=development
DEBUG=true

# Database Connection URLs (Standard PostgreSQL setup)
# DATABASE_URL must denote postgresql+asyncpg for asynchronous operational drivers
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ame
# SYNC_DATABASE_URL denotes standard postgresql for synchronous migration runner (Alembic)
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ame

# Cryptographic token signing secret. Overwrite this in production environments!
JWT_SECRET_KEY=dev-secret-token-key-should-be-randomly-generated-hex-value-64-chars

# LLM Gateway access configurations
OPENAI_API_KEY=your-openai-api-key-here
LLM_MODEL=gpt-4o

# Hybrid Memory System (Milestone 7)
DEFAULT_MEMORY_SYSTEM=Semantic
WORKING_MEMORY_TTL_HOURS=24
